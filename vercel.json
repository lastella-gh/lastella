{
  "images": {
    "sizes": [128, 256, 384, 640, 768, 1024, 1280],
    "qualities": [75],
    "domains": [],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "wgkbudzediwknmbdxvgy.supabase.co",
        "pathname": "^/storage/v1/object/public/product-images/.*$"
      }
    ],
    "minimumCacheTTL": 2592000,
    "formats": ["image/webp"]
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
